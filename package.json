  "description": "PestShield Pro - Pest Control CRM Desktop Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "capacitor:init": "npx @capacitor/cli init pestshield-pro-crm com.pestshield.crm --web-dir=public",
